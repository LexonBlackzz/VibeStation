#define IDR_VIBESTATION_BACKGROUND 101
#define IDR_VIBESTATION_STARTUP_ICON 102
#define IDR_VIBESTATION_CURSOR_WAV 103
#define IDR_VIBESTATION_OPEN_WAV 104
#define IDR_VIBESTATION_CLOSE_WAV 105
#define IDR_VIBESTATION_LOGO_WAV 106
#define IDR_VIBESTATION_TV_GLITCH_OGG 107
#define IDR_VIBESTATION_TV_FEARED_OGG 108

IDI_APP_ICON ICON "vibestation.ico"

IDR_VIBESTATION_BACKGROUND RCDATA "ui\\definitive\\background.jpg"
IDR_VIBESTATION_STARTUP_ICON RCDATA "icon512x512.png"
IDR_VIBESTATION_CURSOR_WAV RCDATA "ui\\definitive\\sounds\\cursor.wav"
IDR_VIBESTATION_OPEN_WAV RCDATA "ui\\definitive\\sounds\\open.wav"
IDR_VIBESTATION_CLOSE_WAV RCDATA "ui\\definitive\\sounds\\close.wav"
IDR_VIBESTATION_LOGO_WAV RCDATA "ui\\definitive\\sounds\\logo.wav"
IDR_VIBESTATION_TV_GLITCH_OGG RCDATA "ui\\definitive\\sounds\\fearfulambience.ogg"
IDR_VIBESTATION_TV_FEARED_OGG RCDATA "ui\\definitive\\sounds\\feared.ogg"

// VibeStation 2 (experimental/ps2/resources/vs2; forward slashes, because
// rc reads "\r" in "\resources" as an escape). Named rather than numbered:
// the PS2 frontend finds each file as its name in capitals with - and . as _
// (load_asset() in experimental/ps2/ui/vs2/vs2_assets.cpp).
VS2_BOOT_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-boot.wav"
VS2_BACKTOMENU_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-backtomenu.wav"
VS2_HIGHLIGHT_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-highlight.wav"
VS2_MENUOPEN_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-menuopen.wav"
VS2_MENUCLOSE_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-menuclose.wav"
VS2_SELECTED_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-selected.wav"
VS2_AMBIENTBG_OGG RCDATA "../experimental/ps2/resources/vs2/vs2-ambientbg.ogg"
VS2_CERTAINSTATIC_WAV RCDATA "../experimental/ps2/resources/vs2/vs2-certainstatic.wav"
PS_PNG RCDATA "../experimental/ps2/resources/vs2/ps.png"
PS2_PNG RCDATA "../experimental/ps2/resources/vs2/ps2.png"
